table PLTRRent

	column Value
		dataType: double
		summarizeBy: none
		sourceColumn: [Value]
		formatString: €#,0.00;(€#,0.00);€0.00

		extendedProperty ParameterMetadata = {"version":0}

	partition PLTRRent = calculated
		mode: import
		source = DISTINCT(UNION(GENERATESERIES(500, 1500, 25), ROW("Value", CALCULATE(AVERAGE(Listings[Rent]), Listings[Cohort] = "primary"))))
